{
    "buildCommand": "",
    "outputDirectory": ".",
    "rewrites": [
        { "source": "/api/contact", "destination": "/api/contact.js" },
        { "source": "/api/newsletter", "destination": "/api/newsletter.js" },
        { "source": "/api/order", "destination": "/api/order.js" },
        { "source": "/api/admin/:path*", "destination": "/api/admin.js" }
    ],
    "headers": [
        {
            "source": "/css/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/js/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/(.*).html",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
        }
    ]
}
